{
  "name": "bobobox",
  "version": "1.0.0",
  "description": "Bobobox — a festa de minigames no celular. Escaneia o QR, entra pelo celular e briga com os amigos na TV.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "simulate": "node scripts/simulate.js",
    "check": "node scripts/check-content.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "party-game",
    "jackbox-like",
    "multiplayer",
    "pt-br",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "express": "^4.22.3",
    "htm": "^3.1.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "socket.io-client": "^4.8.4"
  }
}
